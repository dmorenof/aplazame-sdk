  "/orders": {
   "get": {
    "operationId": "listOrders",
    "summary": "List orders (filters go in the query as `property-lookup=value`, e.g. `id-startswith=e791f`)",
    "tags": [
     "Orders"
    ],
    "security": [
     {
      "privateKey": []
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/vnd.aplazame.v1+json": {
        "schema": {
         "$ref": "#/components/schemas/OrderList"
