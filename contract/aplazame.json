     },
     "400": {
      "description": "Validation error",
      "content": {
       "application/vnd.aplazame.v1+json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "Missing or wrong key"
     },
     "403": {
      "description": "Forbidden"
     },
     "404": {
      "description": "Not found"
     }
    },
    "parameters": [
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "Page number"
     },
     {
      "name": "id-startswith",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "id-endswith",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "total_amount-gte",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "total_amount-lte",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "created-gte",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "format": "date-time"
      }
     },
     {
      "name": "confirmed-isnull",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "yes",
        "no"
       ]
      }
     }
    ]
   }
  },
