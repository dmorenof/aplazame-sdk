{
 "openapi": "3.0.3",
 "info": {
  "title": "Aplazame API",
  "version": "1.0.0",
  "description": "Aplazame (buy now, pay later) merchant API: checkout creation, order management (captures, voids, refunds, cancellation, history), campaigns and POS checkout. Reconstructed from the public documentation at https://aplazame.com/en/docs/api/ : Aplazame publishes no machine-readable contract. Amounts are integers in cents. The version is chosen by the media type of `Accept` (`application/vnd.aplazame.v1+json`; the POS checkout uses v3). The notification Aplazame sends to the merchant (`notification_url`) is documented as the `Notification` model, and its answer as `ConfirmationResponse`. The documentation of the campaign articles and of the answer to `POST /checkout` is not complete."
 },
 "servers": [
  {
   "url": "https://api.aplazame.com"
  }
 ],
 "paths": {
  "/checkout": {
   "post": {
    "operationId": "createCheckout",
    "summary": "Create a checkout (installments by default; product.type selects pay_later or pay_in_4)",
    "tags": [
     "Checkout"
    ],
    "security": [
     {
      "privateKey": []
     }
    ],
    "responses": {
     "201": {
      "description": "Checkout created (the answer is not documented in detail; it is the checkout id)",
      "content": {
       "application/vnd.aplazame.v1+json": {
        "schema": {
         "$ref": "#/components/schemas/Checkout"
        }
       }
      }
     },
     "200": {
      "description": "The same, with 200",
      "content": {
       "application/vnd.aplazame.v1+json": {
        "schema": {
         "$ref": "#/components/schemas/Checkout"
        }
       }
      }
     },
     "400": {
      "description": "Validation error",
      "content": {
       "application/vnd.aplazame.v1+json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "Missing or wrong key"
     },
     "403": {
      "description": "Forbidden"
     },
     "404": {
      "description": "Not found"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CheckoutRequest"
       }
      }
     }
    }
   }
  },
